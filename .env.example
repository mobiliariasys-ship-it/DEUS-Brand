PUBLIC_KEY=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PORT=3000

# Entorno: development | production
NODE_ENV=development

# URL pública del backend (vacía en desarrollo).
# En producción: https://tu-dominio.com
PUBLIC_URL=

# Correo para recibir pedidos (Gmail + App Password de 16 dígitos)
GMAIL_USER=tucorreo@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Transbank Webpay Plus (opcional — sin esto usa modo PRUEBAS/integración)
# Para producción: pide tu Commerce Code y API Key a Transbank y pon TRANSBANK_ENV=production
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=
TRANSBANK_ENV=integration

# Flow (Webpay + tarjetas) — credenciales del panel flow.cl
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_ENV=production

# Credenciales de couriers (opcionales — sin ellas corre en modo simulado)
CHILEXPRESS_API_KEY=
STARKEN_API_KEY=
STARKEN_USER=
BLUEXPRESS_API_KEY=

# Marketing API de Meta (control de Ads Manager desde el panel admin).
# Business Settings → Usuarios del sistema → crear System User (rol Admin) →
# generar token permanente con permisos ads_management + ads_read, asignado
# a la cuenta publicitaria. El id de cuenta (act_XXXXXXXXXXX) sale de la URL
# de Ads Manager. Sin esto, la sección Ads del panel admin muestra error 503.
META_ADS_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# Base de datos (opcional). Sin esto, ventas/pedidos/tickets/vistas se
# guardan en archivos locales (sobreviven al sueño de Render, pero no a un
# deploy nuevo). Con DATABASE_URL apuntando a un Postgres (ej. gratis en
# neon.tech), sobreviven también a los deploys. Formato:
# postgres://usuario:clave@host/basededatos?sslmode=require
DATABASE_URL=
